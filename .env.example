# ─── Authentication ───────────────────────────────────────────────
AUTH_SECRET=your-nextauth-secret-here
AUTH_URL=https://your-domain.vercel.app
AUTH_TRUST_HOST=true

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://...neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://...neon.tech/neondb?sslmode=require

# ─── Cache / Rate Limiting ────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ─── LLM APIs (add as many as possible for reliability) ──────────────
AZURE_OPENAI_API_KEY=           # Azure OpenAI Key 1 — PRIMARY (no quota)
AZURE_OPENAI_ENDPOINT=https://gapforge-openai.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview
GROQ_API_KEY=gsk_...            # Free at console.groq.com — FALLBACK 1
GEMINI_API_KEY=AIza...          # Free at aistudio.google.com — FALLBACK 2
OPENAI_API_KEY=sk-...           # Optional — FALLBACK 3
ANTHROPIC_API_KEY=sk-ant-...    # Optional — FALLBACK 4

# ─── Email ────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# ─── Payments ─────────────────────────────────────────────────────
PAYSTACK_PUBLIC_KEY=pk_live_...
PAYSTACK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_...

FLW_SECRET_KEY=FLWSECK_TEST-...
FLW_WEBHOOK_HASH=your-flutterwave-webhook-hash

# ─── Reference Managers ───────────────────────────────────────────
ZOTERO_API_KEY=your-zotero-api-key
MENDELEY_CLIENT_ID=your-mendeley-client-id
MENDELEY_CLIENT_SECRET=your-mendeley-client-secret

# ─── Institutional API ────────────────────────────────────────────
INSTITUTIONAL_API_SECRET=your-institutional-api-secret

# ─── Cron Security ────────────────────────────────────────────────
CRON_SECRET=your-cron-secret-here

# ─── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Admin ────────────────────────────────────────────────────────
# Email of the admin user (gahedmund146@gmail.com)
ADMIN_EMAIL=gahedmund146@gmail.com
